# Public / non-secret demo configuration. Safe to expose in local docs.
PORT=3000
MCP_BASE_URL=http://localhost:3000
MCP_PATH=/mcp
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=mcp-demo
KEYCLOAK_ISSUER=http://localhost:8080/realms/mcp-demo
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/mcp-demo/protocol/openid-connect/certs
MCP_AUDIENCE=mcp-demo-resource
CORS_ORIGINS=
KEYCLOAK_ADMIN=admin
INTERNAL_OIDC_ISSUER=https://oidc.internal.example.com
INTERNAL_OIDC_AUTHORIZATION_URL=https://oidc.internal.example.com/oauth2/authorize
INTERNAL_OIDC_TOKEN_URL=https://oidc.internal.example.com/oauth2/token
INTERNAL_OIDC_USERINFO_URL=https://oidc.internal.example.com/oauth2/userinfo
INTERNAL_OIDC_JWKS_URL=https://oidc.internal.example.com/.well-known/jwks.json

# Secret configuration. Never commit real values.
KEYCLOAK_ADMIN_PASSWORD=admin
INTERNAL_OIDC_CLIENT_ID=
INTERNAL_OIDC_CLIENT_SECRET=

# Development/build-only corporate network configuration.
# These proxy values are passed to Go commands and Docker build steps only; the runtime MCP container does not set them.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,keycloak,mcp
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,keycloak,mcp

# Optional local development CA certificate path used by Makefile if the file exists.
# Put the approved corporate CA certificate at certs/internal-ca.crt.
INTERNAL_CA_CERT=certs/internal-ca.crt
