# MCP protected resource
PORT=3000
MCP_BASE_URL=http://localhost:3000
MCP_RESOURCE_PATH=/mcp
MCP_RESOURCE_ID=mcp-demo-resource
MCP_REALM=mcp-demo
MCP_REQUIRED_AUDIENCES=mcp-demo-resource,http://localhost:3000/mcp
CORS_ORIGINS=http://localhost:3000

# Keycloak authorization server / broker
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=mcp-demo
KEYCLOAK_ISSUER=http://localhost:8080/realms/mcp-demo
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/mcp-demo/protocol/openid-connect/certs

# Optional Google upstream IdP bootstrap values. Do not commit real secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
